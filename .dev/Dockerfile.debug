FROM dhi.io/node:24.21.0-dev@sha256:b240a2ea0a4e7d9086a3bc1a37f456e0ecd7af9137d8f6c86186d49a27e473d7 AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
