FROM dhi.io/node:24.20.0-dev@sha256:c87cf88c8c9a63ce7fcbd1b1cf18e1d947b9fbacfaa98dacb95df0e4d72a2b5c AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
