FROM dhi.io/node:24.19.0-dev@sha256:d622ee76f018e4857d4531b97205be6f09ba47b28d30212894b197caf45416d1 AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
