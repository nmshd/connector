FROM dhi.io/node:26.13.0-dev@sha256:d51251ff62ddc8771572a7a47c42092e0d576926640d505eff46ec64e2b27cba AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
