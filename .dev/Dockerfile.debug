FROM dhi.io/node:24.21.0-dev@sha256:6706436c04c98c30c236cad2935d20400efa940b22dc1c8bb69621d79dddb74c AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
