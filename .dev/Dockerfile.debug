FROM dhi.io/node:24.22.2-dev@sha256:b1d6cd9f72304d1b5085ed2485b4a8bfcb51247b1b81e96b5cd3113b386a8fc5 AS builder
WORKDIR /usr/app

# Webserver, Debugger
EXPOSE 80 9229

ENTRYPOINT ["npx", "nodemon", "-e", "js,json,yml", "--watch", "./dist", "--watch", "./config", "--inspect=0.0.0.0:9229", "--nolazy", "./dist/index.js", "start"]
